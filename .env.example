# ============================================================
# Application
# ============================================================
# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# ============================================================
# Database (PostgreSQL)
# ============================================================
# Hostname of the PostgreSQL server
DB_HOST=localhost

# Port of the PostgreSQL server
DB_PORT=5432

# Name of the application database
DB_NAME=ecommerce_dev

# PostgreSQL username
DB_USER=postgres

# PostgreSQL password
DB_PASSWORD=postgres

# ============================================================
# Test Database (PostgreSQL)
# ============================================================
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=ecommerce_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# ============================================================
# JSON Web Tokens
# ============================================================
# Secret used to sign access tokens — must be long and random
JWT_SECRET=change_me_to_a_long_random_string

# Access token expiry expressed as a zeit/ms string or seconds
JWT_EXPIRES_IN=15m

# Secret used to sign refresh tokens
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# Refresh token expiry
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Bcrypt
# ============================================================
# Number of salt rounds for bcrypt hashing (10-12 recommended)
BCRYPT_ROUNDS=10

# ============================================================
# Elasticsearch
# ============================================================
# Full URL of the Elasticsearch node
ELASTICSEARCH_URL=http://localhost:9200

# Optional: Elasticsearch username (leave blank if not secured)
ELASTICSEARCH_USERNAME=

# Optional: Elasticsearch password
ELASTICSEARCH_PASSWORD=

# Name of the products index
ELASTICSEARCH_INDEX=products

# ============================================================
# Rate Limiting
# ============================================================
# Window size in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001

# ============================================================
# Logging
# ============================================================
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory where log files are written
LOG_DIR=logs

# ============================================================
# Payment Gateway (Mock)
# ============================================================
# Adapter to use: mock | stripe | razorpay
PAYMENT_ADAPTER=mock

# API key for the payment gateway (not used by mock adapter)
PAYMENT_GATEWAY_KEY=
